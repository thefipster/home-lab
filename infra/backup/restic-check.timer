[Unit]
Description=Weekly restic repository check

[Timer]
# Sunday 03:00 — after that night's 01:00 backup, so the two jobs that DO touch
# the `filebackup` pool never overlap on it. (vzdump at 02:00 is not a third
# contender: it writes to the `vmbackup` mirror. Staying clear of it is about
# host I/O, not the pool.)
OnCalendar=Sun *-*-* 03:00:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
