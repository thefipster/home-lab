# Copy to .env (gitignored) on the infra VM. scripts/init-forgejo.sh seeds this
# file and fills in BOTH values — you normally never edit it by hand.

# Numeric GID of the host `docker` group. The runner image runs as uid 1000 but
# /var/run/docker.sock is root:docker, so the runner joins the group by GID.
# Recorded by init-forgejo.sh: getent group docker | cut -d: -f3
DOCKER_GID=

# Password for Forgejo's dedicated Postgres. Leave blank: init-forgejo.sh
# generates one (openssl rand -base64 36). NOTE: Postgres keeps the password
# its data dir was FIRST initialized with — on an existing deployment set this
# to the current password instead (or rotate it via ALTER USER).
FORGEJO_DB_PASSWORD=
