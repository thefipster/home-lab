# Optional overrides. On Coolify these belong in the resource's environment editor;
# locally, copy this file to .env.
#
# NOT listed here: SERVICE_PASSWORD_64_SESSION / SERVICE_HEX_64_SESSIONKEY /
# SERVICE_HEX_32_SESSIONIV. Coolify generates those.

# The public URL of this instance, scheme included — becomes Habitica's BASE_URL.
# Must match the domain configured under Coolify -> Domains. Reached through the
# *.thefipster.de wildcard, so this name needs no DNS record of its own.
PUBLIC_URL=https://habitica.thefipster.de

TZ=Europe/Berlin
WEB_CONCURRENCY=1

# Sender address for outgoing mail, and the instance's admin contact.
ADMIN_EMAIL=changeme@example.com

# Deploy with false, register the accounts you want — the first one becomes admin —
# then set true and redeploy. There is no SSO in front of this instance, so this is
# what keeps registration closed.
INVITE_ONLY=false

# --- local-only: values Coolify would generate ---
# Rotating any of these after the first start is destructive: SESSION_SECRET_KEY is
# the AES-256 key the server encrypts stored values with. Keep them beside the
# database in any backup.
# Generate with: openssl rand -hex 32   (SESSION_SECRET_KEY, 64 hex characters)
# SERVICE_HEX_64_SESSIONKEY=
# Generate with: openssl rand -hex 16   (SESSION_SECRET_IV, 32 hex characters)
# SERVICE_HEX_32_SESSIONIV=
# SERVICE_PASSWORD_64_SESSION=change-me
