# Optional overrides. On Coolify these belong in the resource's environment editor;
# locally, copy this file to .env.
#
# NOT listed here: SERVICE_PASSWORD_POSTGRES. Coolify generates it.
# For a local `docker compose up` you must set it yourself.

# The public URL of this instance, scheme included — becomes Mealie's BASE_URL.
# Must match the domain configured under Coolify -> Domains. Reached through the
# *.thefipster.de wildcard, so this name needs no DNS record of its own.
PUBLIC_URL=https://mealie.thefipster.de

TZ=Europe/Berlin
PUID=1000
PGID=1000

# "true" lets anyone with the URL create an account. Keep false and invite users instead.
ALLOW_SIGNUP=false

# First-run admin account (only read on an empty database).
DEFAULT_EMAIL=changeme@example.com
DEFAULT_GROUP=Home
DEFAULT_HOUSEHOLD=Family

MAX_WORKERS=1
WEB_CONCURRENCY=1

# --- SSO (OIDC via Authentik) ---
# Blank until the Authentik provider exists; the stack runs fine without it.
# Flip OIDC_ENABLED to true in the same step you paste the two values in.
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only members of this Authentik group can sign in.
OIDC_USER_GROUP=lab-users
# Keep true. It is the break-glass path when Authentik is down.
ALLOW_PASSWORD_LOGIN=true

# --- local-only: value Coolify would generate ---
# SERVICE_PASSWORD_POSTGRES=change-me
