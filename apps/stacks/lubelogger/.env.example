# Optional overrides. On Coolify these belong in the resource's environment editor;
# locally, copy this file to .env.
#
# NOT listed here: SERVICE_PASSWORD_POSTGRES. Coolify generates it.
#
# No PUBLIC_URL: LubeLogger has no public-URL setting of its own. The domain
# (https://lube.thefipster.de) is set once under Coolify -> Domains and nowhere else.

TZ=Europe/Berlin

# Number / currency / date formatting inside the app.
LC_ALL=de_DE.UTF-8
LANG=de_DE.UTF-8

# --- SSO (OIDC via Authentik) ---
# LubeLogger has no enable flag — the SSO button appears once these two carry
# values, so blank keeps it off. Everything else (endpoints, PKCE, redirect URL)
# is fixed in the compose. Authentication itself must be switched on in the app's
# Settings tab first; OIDC does nothing while LubeLogger is unauthenticated.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- local-only: value Coolify would generate ---
# SERVICE_PASSWORD_POSTGRES=change-me
