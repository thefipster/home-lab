# Optional overrides. On Coolify these belong in the resource's environment editor;
# locally, copy this file to .env.
#
# NOT listed here: SERVICE_REALBASE64_32_BOOKSTACK / SERVICE_PASSWORD_MARIADB /
# SERVICE_PASSWORD_MARIADBROOT. Coolify generates those.

# The public URL of this instance, scheme included — becomes BookStack's APP_URL.
# Must match the domain configured under Coolify -> Domains. Reached through the
# *.thefipster.de wildcard, so this name needs no DNS record of its own.
PUBLIC_URL=https://wiki.thefipster.de

TZ=Europe/Berlin
PUID=1000
PGID=1000

# --- local-only: values Coolify would generate ---
# SERVICE_PASSWORD_MARIADB=change-me
# SERVICE_PASSWORD_MARIADBROOT=change-me-too
# Generate with:
#   docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:26.05.3 appkey
# then strip the leading "base64:" — the compose file adds it back.
# SERVICE_REALBASE64_32_BOOKSTACK=
