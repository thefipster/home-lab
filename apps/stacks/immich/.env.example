# Optional overrides. On Coolify these belong in the resource's environment editor;
# locally, copy this file to .env.
#
# NOT listed here: SERVICE_PASSWORD_POSTGRES. Coolify generates it.
#
# There is no PUBLIC_URL and there are no OIDC_* values in this file, unlike
# every other stack here. Immich takes its public host from the request, and its
# OAuth settings live in its own database (Administration -> Settings), not in
# the environment — see the README.

# Fallback timezone for photos whose metadata carries none, plus log timestamps.
TZ=Europe/Berlin

# Closes /auth/admin-sign-up once the admin account exists. Leave it true for the
# first deploy or there is no way to create that account. Setting it false also
# disables the database-restore endpoint, so flip it back before a restore.
# IMMICH_ALLOW_SETUP=false

# --- local-only: value Coolify would generate ---
# SERVICE_PASSWORD_POSTGRES=change-me
