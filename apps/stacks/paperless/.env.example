# Optional overrides. On Coolify these belong in the resource's environment editor;
# locally, copy this file to .env.
#
# NOT listed here: SERVICE_REALBASE64_64_PAPERLESS / SERVICE_PASSWORD_POSTGRES /
# SERVICE_PASSWORD_ADMIN. Coolify generates those.

# The public URL of this instance, scheme included — becomes PAPERLESS_URL. Must match
# the domain configured under Coolify -> Domains, or login fails CSRF validation.
# Reached through the *.thefipster.de wildcard, so this name needs no DNS record.
PUBLIC_URL=https://paperless.thefipster.de

TZ=Europe/Berlin
PUID=1000
PGID=1000

# ISO 639-2 codes, "+" separated. deu, eng, ita, spa, fra ship with the image.
PAPERLESS_OCR_LANGUAGE=deu+eng

# Seeded only on an empty database.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_MAIL=admin@example.com

# Raise on a beefier host; each task worker can saturate a core during OCR.
PAPERLESS_TASK_WORKERS=2
PAPERLESS_WEBSERVER_WORKERS=2

# --- SSO (OIDC via Authentik) ---
# The provider JSON lives in the compose file; only these three are set here.
# OIDC_ENABLED_APP is the switch — blank leaves the provider block inert. Set it to
# the exact string below in the same step you paste the two credentials in.
OIDC_ENABLED_APP=
# OIDC_ENABLED_APP=allauth.socialaccount.providers.openid_connect
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- local-only: values Coolify would generate ---
# SERVICE_PASSWORD_POSTGRES=change-me
# SERVICE_PASSWORD_ADMIN=change-me-too
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# SERVICE_REALBASE64_64_PAPERLESS=
